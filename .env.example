# ==============================================================================
# BHIMOS — Dr. B. R. Ambedkar Digital Heritage Archive
# Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite / React)
# ------------------------------------------------------------------------------
# Title displayed in browser header and metadata
VITE_APP_TITLE="BHIMOS — Ambedkar Digital Heritage Archive"

# Set to 'true' only on dedicated physical museum kiosk hardware.
# On normal web deployment, leave 'false' to prevent interrupting reader exploration.
VITE_ENABLE_KIOSK_MODE=false

# Inactivity timeout in seconds before prompt appears (only when kiosk mode enabled)
VITE_KIOSK_TIMEOUT_SECONDS=90

# Production API Endpoint for semantic search, RAG retrieval, and OCR extraction
# In local dev: http://localhost:8000/api
# In production: https://api.bhimos.org/api or /api (when behind reverse proxy)
VITE_API_BASE_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# BACKEND API & SERVER CONFIGURATION (FastAPI / Python)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4173,https://bhimos.org,https://www.bhimos.org

# Path to the primary SQLite archival database (relative to project root or absolute)
DATABASE_PATH=data/heritage.db

# Path to FAISS vector index and embedding model
FAISS_INDEX_PATH=data/vector/heritage.faiss
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ------------------------------------------------------------------------------
# OPTIONAL: OCR ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# Path to Tesseract binary (if not in system PATH)
# On Linux: /usr/bin/tesseract
# On Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract
OCR_MAX_FILE_SIZE_MB=15

# ------------------------------------------------------------------------------
# OPTIONAL: GOOGLE DRIVE ARCHIVAL STORAGE INTEGRATION
# ------------------------------------------------------------------------------
# If enabling Google Drive synchronization, provide service account JSON file path
# or credentials. Leave empty if using local file system storage.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=config/google_drive_credentials.json
GOOGLE_DRIVE_ROOT_FOLDER_NAME="DR_AMBEDKAR_DIGITAL_HERITAGE_ARCHIVE"
